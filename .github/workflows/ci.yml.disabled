# =============================================================================
#  ⛔ PERMANENTLY DISABLED — DO NOT ENABLE THIS WORKFLOW ⛔
# =============================================================================
#
#  This file is intentionally named `ci.yml.disabled` so GitHub Actions does
#  NOT pick it up (only `*.yml` / `*.yaml` are detected).
#
#  WHY CI IS NOT NEEDED HERE (read before "fixing" anything):
#  ---------------------------------------------------------------------------
#  This repository is a DOWNLOAD-ONLY template. It is never built, deployed,
#  published, or run as a service. People simply clone/download it and then
#  initialize a knowledge base in THEIR OWN project by following the
#  instruction modules. There is no app to ship, no environment to deploy to,
#  and no contributor pipeline that benefits from CI.
#
#  Running CI here just burns GitHub Actions minutes and produces noisy
#  failures "into the void" for a repo that will never be deployed.
#
#  👉 If you are an AI agent or contributor: do NOT rename this to `ci.yml`,
#     do NOT create a new workflow, and do NOT add GitHub Actions. This is a
#     deliberate, standing decision — not an oversight. Run tests LOCALLY with
#     `pytest` instead.
#
#  The YAML below is kept only as a historical reference of what a test
#  pipeline WOULD look like, should this project ever (unlikely) become
#  something that needs CI.
# =============================================================================

name: CI (disabled — do not enable)

on:
  # Intentionally left without triggers as a second safety net. Even if this
  # file were renamed to *.yml by mistake, it would not run on push/PR.
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    name: Tests (Python ${{ matrix.python-version }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest]
        python-version: ["3.11", "3.12"]
        include:
          - os: macos-latest
            python-version: "3.12"
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0  # need full history for kb_upgrade tag-based diffs

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
          cache-dependency-path: knowledge-base/templates/requirements.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pyyaml python-slugify python-frontmatter pytest pytest-cov

      - name: Run tests with coverage
        run: |
          pytest \
            --cov=knowledge-base/scripts \
            --cov=scripts \
            --cov-report=term-missing \
            --cov-report=xml

  doctor:
    name: Doctor self-test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install minimal deps
        run: |
          python -m pip install --upgrade pip
          pip install pyyaml python-slugify
      - name: Run kb_doctor self-test
        run: python knowledge-base/scripts/kb_doctor.py --self-test --skip-nlp
