# Virtual env
.venv/
venv/
__pycache__/
*.pyc

# Repomix output (regenerated locally)
.repomix/output.xml
.repomix/

# Operational state (regenerated, not source of truth)
.last_consolidation
.last_reflection
.watcher.pid
.watcher.log

# Lint reports (regenerated)
lint-report.md

# Cross-base sync workspace (see 16_MERGE.md). Bundles are large binaries and
