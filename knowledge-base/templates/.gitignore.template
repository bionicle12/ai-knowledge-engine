# the base — drop the last line to do that.
sync/inbox/
sync/outbox/
sync/applied/
sync/backups/
sync/reports/

# Optional: ignore raw materials (sensitive). Uncomment if you don't want
# to version-control source documents.
# raw/
# assets/
# review/

# Optional: ignore session logs (private). Uncomment to exclude.
# interactions/
# log.md

# OS
.DS_Store
Thumbs.db
