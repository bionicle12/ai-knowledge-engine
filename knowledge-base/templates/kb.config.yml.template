# AI Knowledge Engine — kb.config.yml
# Copy to your KB root as `kb.config.yml` and parameterize {{placeholders}}.
# See 02_INIT.md and 11_PROVENANCE.md for field descriptions.

# Bookkeeping
instructions_version: "{{KB_INSTRUCTIONS_VERSION}}"   # populated from repo VERSION at deploy time
deployed_at: "{{DEPLOYED_AT}}"                         # ISO-8601 date

knowledge_base:
  name: "{{KB_NAME}}"                                  # e.g., "personal-professional-kb"
  mode: "default"                                      # default | super (toggle via !super)
  language: "{{PRIMARY_LANGUAGE}}"                     # e.g., "ru", "en"
  index_policy: "clean-knowledge-only"

  roles:
    primary: "{{PRIMARY_ROLE}}"                        # e.g., "Senior Software Engineer"
    hobbies: []                                        # optional, e.g., ["AI music production"]

# Privacy & indexing rules
privacy:
  raw_indexing_allowed: false
  review_indexing_allowed: false
  interactions_indexing_allowed: false
  external_ai_allowed: false
  require_redaction_for_chats: true

# Language behavior (extraction & metadata)
language_policy:
  primary: "{{PRIMARY_LANGUAGE}}"
  extraction_rule: "extract in primary language; preserve original terms/brand names verbatim"
  metadata_language: "en"                              # for slugs, frontmatter keys

# Catch-up after upgrade (see 18_HEAL.md). auto_apply lets kb_upgrade.py
# run kb_heal.py --apply auto; assisted/human still need !heal.
heal:
  auto_apply: true
  stage: 1                    # 1 safe | 2 hygiene | 3 measure | 4 trim | 5 content
  assisted_batch: 20          # max assisted items per !heal session
  # last_run:
  #   at: "{{DEPLOYED_AT}}"
  #   version: "{{KB_INSTRUCTIONS_VERSION}}"

# Set by !profile-review. Lint warns if reviewed_at is older than 30 days.
# Skip the warning if the field is missing.
# profile_review:
#   reviewed_at: "{{DEPLOYED_AT}}"

# Last time these instructions were reviewed against a model generation
# (see 17_REFACTOR.md). Lint warns if reviewed_at is older than
# instructions_lint.review_stale_days. Skip the stale check if reviewed_at
# is empty.
instructions_review:
  reviewed_at: "{{DEPLOYED_AT}}"
  reviewed_model: ""                 # e.g. "gpt-5.6-codex" — fill at first review
  clean_run_baseline: ""             # eval/results/<date>__<what>.md after a clean run

# L1 instruction-budget lint (see 09_LINT.md). Thresholds belong here, not
# in scripts — they will move. mode_profiles.*.lint is L2 only.
instructions_lint:
  agents_max_bytes: 10240
  absolute_max_outside_invariants: 8
  review_stale_days: 90
  work_ordering_phrases:
    - "максимально тщательно"
    - "рассмотри все варианты"
    - "перепроверь несколько раз"
    - "добейся полной уверенности"
    - "thoroughly"
    - "consider all"
    - "be maximally"

# Entities to track (drives knowledge/* folders & routing)
# Source-controlled: copy from examples/<role>.yml during deployment.
entities: {}

# NLP pipeline (see 12_NLP_PREPROCESS.md)
nlp:
  enabled: true
  spacy_model: "{{SPACY_MODEL}}"                       # e.g., "ru_core_news_md", "en_core_web_md"
  spacy_model_fallback: "xx_ent_wiki_sm"
  keyword_top_n: 20
  fuzzy_match_threshold: 0.8
  complexity_threshold: 0.7                            # >= → review/needs-ai-decision/
  skip_extensions: [".csv", ".xlsx"]

# Media processing — transcription (STT), OCR, archive unpacking
# (see 15_MEDIA_PROCESSING.md). Requires: pip install -r requirements-media.txt
media:
  stt:                                                 # audio + video → processed/transcripts/
    enabled: true
    # Backend preference order. faster-whisper needs NO system ffmpeg — it
    # decodes audio via bundled PyAV, so it works out of the box on
    # macOS / Windows / Linux. openai-whisper is a fallback that DOES need a
    # system ffmpeg on PATH.
    backends: ["faster-whisper", "openai-whisper"]
    model: "small"                                     # tiny | base | small | medium | large-v3
    language: "auto"                                   # "auto", or ISO code like "ru" / "en"
    device: "auto"                                     # auto | cpu | cuda
    compute_type: "int8"                               # int8 (fast CPU) | float16 (GPU) | float32
    timestamps: true                                   # add [mm:ss] markers per segment
    allow_cloud: false                                 # reserved; cloud STT not implemented yet
  ocr:                                                 # images/scans → processed/ocr/
    enabled: true
    backends: ["rapidocr", "tesseract"]                # rapidocr needs no system deps
    language: "auto"
  archives:                                            # .zip/.tar(.gz) → unpacked to raw/unsorted/
    enabled: true
    max_files: 200                                     # safety cap when unpacking

# Cross-base import/export — merging two deployments of this base
# (see 16_MERGE.md). Used by scripts/kb_export.py and scripts/kb_import.py.
sync:
  # Name this base carries into the other one. Make it recognisable —
  # it ends up in `merged_from:` on every imported page.
  label: "{{KB_LABEL}}"                                # e.g. "studio-laptop"
  export:
    sections: ["knowledge", "assets-index", "interactions", "meta", "config", "log"]
    with_assets: false                                 # binary originals stay home by default
  import:
    strategy: "safe"                                   # safe | prefer-incoming | prefer-local
    similarity_threshold: 0.85                         # ≥ → flagged as a merge candidate
    backup: true                                       # snapshot every touched file first
    move_applied: true                                 # bundle → sync/applied/ after import

# Auto-run behavior (see 13_AUTORUN.md)
autorun:
  watch_enabled: true
  watch_dirs:
    - "raw/*/unsorted/"
    - "knowledge/"
  debounce_raw_seconds: 5
  debounce_knowledge_seconds: 2
  auto_nlp: true
  auto_lint_on_change: true
  auto_reindex_on_change: true
  complexity_auto_threshold: 0.5
  consolidation_interval_hours: 24
  consolidation_on_reindex: true

# Mode profiles — token-spending behavior (see 07_INTERACTION_LOOP.md)
mode_profiles:
  default:
    surprise:
      engine: "python"            # python (NLP overlap) | ai (semantic)
      ai_trigger_min_words: 3000  # AI fallback only for big docs
      ai_max_per_day: 2
    annotations:
      engine: "python"
    entity_resolution:
      engine: "python"
    importance_scoring:
      engine: "ai"
      with_reasoning: false
    reflection:
      trigger: "threshold+weekly"
      importance_threshold: 25
      min_interval_days: 7
      require_changes: true
      max_insights_per_run: 3
    lint:
      level2_trigger: "manual"    # manual | weekly | daily
      level2_weekly_day: "sunday"
      review_auto_process: false

  super:
    surprise:
      engine: "ai"
      ai_trigger_min_words: 0
      ai_max_per_day: null
    annotations:
      engine: "ai"
    entity_resolution:
      engine: "ai"
    importance_scoring:
      engine: "ai"
      with_reasoning: true
    reflection:
      trigger: "on-demand"
      importance_threshold: 5
      min_interval_days: 0
      require_changes: false
      max_insights_per_run: 5
    lint:
      level2_trigger: "daily"
      review_auto_process: true

# Lifecycle defaults (see 11_PROVENANCE.md)
lifecycle:
  default: "evolving"               # permanent | evolving | temporal
  stale_warning_days: 30
  confidence_decay_days: 90

# Logging (see 10_LOG.md)
logging:
  rotation_threshold: 1000          # entries → rotate to log-archive/
  archive_dir: "log-archive"

# Indexer (see 05_INDEX.md)
indexer:
  tool: "repomix"                   # extensible: future support for other tools
  config_file: "repomix.config.json"
  output_path: ".repomix/output.xml"  # legacy monolith path (pack mode ignores it)

# Pack-based index (see 05_INDEX.md). One monolithic output.xml stops fitting
# a context window as the base grows; packs keep every load under a ceiling.
# compress is ALWAYS false for knowledge bases: full wording is the payload.
index:
  enabled: true
  # primary_agent: "codex"          # codex | cursor | claude-code
  window_profile: "256k"            # 400k (Codex, ceiling 120K) | 256k (80K) | 200k (60K) | 1m (150K)
  # pack_token_ceiling: 80000       # override the profile ceiling explicitly
  # merge_below_tokens: 15000       # sections smaller than this merge into `aux`
  packs: auto
  # `auto`: core (profile/principles/voice/routing + meta) + one pack per
  # knowledge/ section; oversized sections split by subfolder automatically
  # (knowledge/library/craft -> library-craft.xml, ...).
  # Explicit control instead:
  # packs:
  #   - name: library-craft
  #     include: ["knowledge/library/craft/**"]
  #     when_to_load: "writing-craft questions"
