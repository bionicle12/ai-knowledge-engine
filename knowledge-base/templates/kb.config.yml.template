# AI Knowledge Engine — kb.config.yml. Keys: kb-docs/02_INIT.md and the module named per section.
# Scripts edit it line by line (comments survive); a missing key uses the default shown here.
# Markers: "read by the AI agent" (no script reads it), "not implemented yet" (see
# docs/ROADMAP.md in the engine repository), "deprecated" (nothing reads it).

instructions_version: "{{KB_INSTRUCTIONS_VERSION}}"  # `python3 scripts/kb_common.py --version` at deploy time
deployed_at: "{{DEPLOYED_AT}}"  # ISO date; kb_reflect counts the first weekly interval from it

knowledge_base:
  name: "{{KB_NAME}}"
  mode: "default"  # default | super (!super). The ONE place the mode lives; no top-level `mode:`
  language: "{{PRIMARY_LANGUAGE}}"  # read by the AI agent
  index_policy: "clean-knowledge-only"  # read by the AI agent
  roles:
    primary: "{{PRIMARY_ROLE}}"  # `role:` title or file name of examples/<role>.yml (!populate)
    hobbies: []  # read by the AI agent

# kb-docs/05_INDEX.md, 03_PIPELINE.md. processed/ and assets/ are never indexed.
privacy:
  raw_indexing_allowed: false
  review_indexing_allowed: false
  interactions_indexing_allowed: false
  external_ai_allowed: false  # policy flag read by the AI agent, not by scripts
  require_redaction_for_chats: true  # files from redact_categories → review/needs-redaction/
  redact_categories: ["chats", "personal-context"]
  secret_scan: true  # secrets and credential files → review/needs-redaction/

language_policy:
  primary: "{{PRIMARY_LANGUAGE}}"
  extraction_rule: "extract in primary language; preserve original terms/brand names verbatim"  # read by the AI agent
  metadata_language: "en"  # slugs, frontmatter keys; read by the AI agent

# kb-docs/18_HEAL.md
heal:
  auto_apply: true
  stage: 1  # 1 safe | 2 hygiene | 3 measure | 4 trim | 5 content
  assisted_batch: 20
  # last_run:
  #   at: "{{DEPLOYED_AT}}"
  #   version: "{{KB_INSTRUCTIONS_VERSION}}"

# profile_review:  # stamped by !profile-review (kb-docs/07_INTERACTION_LOOP.md)
#   reviewed_at: "{{DEPLOYED_AT}}"

# kb-docs/17_REFACTOR.md, 09_LINT.md
instructions_review:
  reviewed_at: "{{DEPLOYED_AT}}"
  reviewed_model: ""  # read by the AI agent
  clean_run_baseline: ""  # read by the AI agent

instructions_lint:
  agents_max_bytes: 10240
  absolute_max_outside_invariants: 8
  review_stale_days: 90
  work_ordering_phrases:
    - "максимально тщательно"
    - "рассмотри все варианты"
    - "перепроверь несколько раз"
    - "добейся полной уверенности"
    - "thoroughly"
    - "consider all"
    - "be maximally"

# Filled by kb_populate.py --entities-from <role> (kb-docs/14_INITIAL_POPULATION.md)
entities: {}

# kb-docs/03_PIPELINE.md
ingest:
  ignore_globs: [".DS_Store", "Thumbs.db", "desktop.ini", "~$*", "._*", "*.part", "*.crdownload", "*.tmp", "*.swp"]
  max_file_mb: 200  # larger files stay in unsorted/ (kb_ingest.py --status); 0 = no limit
  duplicates_dir: "raw/_duplicates"

# kb-docs/12_NLP_PREPROCESS.md
nlp:
  enabled: true
  spacy_model: "{{SPACY_MODEL}}"
  spacy_model_fallback: "xx_ent_wiki_sm"
  keyword_top_n: 20
  fuzzy_match_threshold: 0.8
  complexity_threshold: 0.7  # >= → review/needs-ai-decision/, else processed/
  skip_extensions: [".csv", ".xlsx"]  # skip NLP enrichment only — files are still ingested

# kb-docs/15_MEDIA_PROCESSING.md
media:
  stt:
    enabled: true
    backends: ["faster-whisper", "openai-whisper"]
    model: "small"
    language: "auto"
    device: "auto"
    compute_type: "int8"
    timestamps: true
    allow_cloud: false  # not implemented yet
  ocr:
    enabled: true
    backends: ["rapidocr", "tesseract"]
    language: "auto"
  archives:
    enabled: true
    max_files: 200
    max_total_mb: 500
    max_member_mb: 200

# kb-docs/16_MERGE.md
sync:
  label: "{{KB_LABEL}}"
  export:
    sections: ["knowledge", "assets-index", "interactions", "meta", "config", "log"]
    with_assets: false
  import:
    strategy: "safe"  # safe | prefer-incoming | prefer-local
    similarity_threshold: 0.85
    backup: true
    move_applied: true

# kb-docs/13_AUTORUN.md
autorun:
  watch_enabled: true
  watch_dirs:
    - "raw/*/unsorted/"
    - "knowledge/"
  debounce_raw_seconds: 5
  debounce_knowledge_seconds: 2
  auto_nlp: true
  auto_lint_on_change: true
  auto_reindex_on_change: true
  # complexity_auto_threshold: deprecated — nlp.complexity_threshold is the only threshold
  consolidation_interval_hours: 24
  consolidation_on_reindex: true

# kb-docs/07_INTERACTION_LOOP.md. Scripts read only `reflection`.
mode_profiles:
  default:
    surprise:  # not implemented yet
      engine: "python"
      ai_trigger_min_words: 3000
      ai_max_per_day: 2
    annotations:  # read by the AI agent
      engine: "python"
    entity_resolution:  # read by the AI agent
      engine: "python"
    importance_scoring:  # read by the AI agent
      engine: "ai"
      with_reasoning: false
    reflection:
      trigger: "threshold+weekly"
      importance_threshold: 25
      min_interval_days: 7
      require_changes: true
      max_insights_per_run: 3
    lint:  # read by the AI agent
      level2_trigger: "manual"  # manual | weekly | daily
      level2_weekly_day: "sunday"  # not implemented yet
      review_auto_process: false

  super:
    surprise:  # not implemented yet
      engine: "ai"
      ai_trigger_min_words: 0
      ai_max_per_day: null
    annotations:  # read by the AI agent
      engine: "ai"
    entity_resolution:  # read by the AI agent
      engine: "ai"
    importance_scoring:  # read by the AI agent
      engine: "ai"
      with_reasoning: true
    reflection:
      trigger: "on-demand"
      importance_threshold: 5
      min_interval_days: 0
      require_changes: false
      max_insights_per_run: 5
    lint:  # read by the AI agent
      level2_trigger: "daily"
      review_auto_process: true

# kb-docs/11_PROVENANCE.md
lifecycle:
  default: "evolving"  # permanent | evolving | temporal
  stale_warning_days: 30
  by_folder:
    decisions: permanent
    profile: permanent
    principles: permanent
  confidence_decay_days: 90  # read by the AI agent, not by scripts

# kb-docs/10_LOG.md
logging:
  rotation_threshold: 1000  # entries; 0 = never rotate
  archive_dir: "log-archive"

indexer:  # deprecated: the `index:` section replaced it
  tool: "repomix"
  config_file: "repomix.config.json"
  output_path: ".repomix/output.xml"

# kb-docs/05_INDEX.md
index:
  enabled: true
  # primary_agent: "codex"  # codex | cursor | claude-code
  window_profile: "256k"  # 400k | 256k | 200k | 1m
  # pack_token_ceiling: 80000
  # merge_below_tokens: 15000
  repomix_version: "1.14.0"
  npx_fallback: true
  packs: auto

status:
  enabled: true
  file: "STATUS.md"
