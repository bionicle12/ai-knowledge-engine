{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": ".repomix/output.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "topFilesLength": 20,
    "headerText": "Local non-code knowledge base. Base config: pack configs in .repomix/configs/ inherit ignore/security from here and kb_reindex.py always adds its privacy floor (see kb-docs/05_INDEX.md). AGENTS.md and kb.config.yml are deliberately not indexed — the agent reads them directly."
  },
  "include": [
    "KNOWLEDGE_STRUCTURE.md",
    "DATA_PLACEMENT_EXAMPLES.md",
    "knowledge/**/*.md",
    "assets-index/**/*.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "raw/**",
      "processed/**",
      "assets/**",
      "review/**",
      "interactions/**",
      "eval/**",
      ".kb-backups/**",
      ".kb-finalize-backup/**",
      ".kb-state/**",
      "kb-docs/**",
      "sync/**",
      "setup/**",
      "scripts/**",
      "shell/**",
      "templates/**",
      ".repomix/**",
      ".venv/**",
      "venv/**",
      ".git/**",
      "node_modules/**",
      "__pycache__/**",
      "log.md",
      "log-archive/**",
      "lint-report.md",
      "STATUS.md",
      "HEAL_PLAN.md",
      ".env",
      ".env.*",
      "**/*.pem",
      "**/*.key",
      ".last_consolidation",
      ".last_reflection",
      ".watcher.pid",
      ".watcher.log",
      "**/*.pdf", "**/*.docx", "**/*.pptx", "**/*.xlsx",
      "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.webp", "**/*.gif",
      "**/*.mp3", "**/*.wav", "**/*.mp4", "**/*.mov",
      "**/*.zip", "**/*.tar.gz", "**/*.rar"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
