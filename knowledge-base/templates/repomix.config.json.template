{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": ".repomix/output.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "topFilesLength": 20,
    "headerText": "Local non-code knowledge base. Base config: pack configs in .repomix/configs/ inherit ignore/security from here (see 05_INDEX.md). AGENTS.md is deliberately not indexed — it is already in the system prompt."
  },
  "include": [
    "README.md",
    "KNOWLEDGE_STRUCTURE.md",
    "DATA_PLACEMENT_EXAMPLES.md",
    "kb.config.yml",
    "knowledge/**/*.md",
    "assets-index/**/*.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "raw/**",
      "processed/**",
      "assets/**",
      "review/**",
      "interactions/**",
      "sync/**",
      "setup/**",
      "scripts/**",
      "shell/**",
      "templates/**",
      ".repomix/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "log.md",
      "log-archive/**",
      "lint-report.md",
      ".last_consolidation",
      ".last_reflection",
      ".watcher.pid",
      ".watcher.log",
      "**/*.pdf", "**/*.docx", "**/*.pptx", "**/*.xlsx",
      "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.webp", "**/*.gif",
      "**/*.mp3", "**/*.wav", "**/*.mp4", "**/*.mov",
      "**/*.zip", "**/*.tar.gz", "**/*.rar"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
