{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-skills-fixer source registry",
  "type": "object",
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "ref", "layout"],
        "properties": {
          "url": {"type": "string"},
          "ref": {"type": "string"},
          "layout": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"type": "string", "enum": ["collection", "single"]},
              "roots": {"type": "array", "items": {"type": "string"}},
              "skill_path": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
