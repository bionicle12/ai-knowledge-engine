{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-skills-fixer lockfile / lock proposal",
  "type": "object",
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "source_id", "url", "requested_ref",
                     "resolved_commit", "skill_path", "content_hash",
                     "release"],
        "properties": {
          "skill_id": {"type": "string"},
          "source_id": {"type": "string"},
          "url": {"type": "string"},
          "requested_ref": {"type": "string"},
          "resolved_commit": {"type": "string"},
          "skill_path": {"type": "string"},
          "content_hash": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "release": {"type": "string"},
          "audit": {
            "type": "object",
            "properties": {
              "status": {"type": "string"},
              "checked_at": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
